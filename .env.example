# Root env template. Copy to `.env`. Overrides go in `.env.local`.
# Do not reintroduce keys removed from this file.

# Core
# APP_ORIGIN = SPA (auth trustedOrigins, email links)
# API_ORIGIN = API (Vite proxy → VITE_API_URL)
APP_NAME="Charro Stack"
ENVIRONMENT=development
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3456
PORT=3456

# Database (compose host port 5452)
DATABASE_URL=postgres://postgres:postgres@localhost:5452/example

# Auth — bunx @better-auth/cli@latest secret
BETTER_AUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SUPER_ADMIN_EMAIL=admin@example.com
# ALLOW_PROD_SEED=true

# Email (Resend) — https://resend.com/api-keys
RESEND_API_KEY=xxxxx
RESEND_EMAIL_FROM=onboarding@resend.dev

# Object storage (S3-compatible). Empty bucket disables uploads.
STORAGE_S3_REGION=auto
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_ENDPOINT=
STORAGE_S3_FORCE_PATH_STYLE=false

# PostHog — API + SPA (Vite maps to VITE_POSTHOG_*). Omit KEY to disable.
POSTHOG_KEY=phc_xxxxx
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_FLUSH_AT=20
POSTHOG_FLUSH_INTERVAL_MS=10000
POSTHOG_REQUEST_TIMEOUT_MS=10000
POSTHOG_SERVER_ERROR_SAMPLE_RATE=1
POSTHOG_REPLAY_SAMPLE_RATE=0.15
POSTHOG_ERROR_SAMPLE_RATE=1
POSTHOG_REQUIRE_CONSENT=true
# POSTHOG_MASK_TEXT_SELECTORS=
# POSTHOG_BLOCK_SELECTORS=
# POSTHOG_TRACE_TARGETS=

# Marketing (Astro, loaded from repo root)
PUBLIC_APP_ORIGIN=http://localhost:4321
PUBLIC_SPA_ORIGIN=http://localhost:5173

# Docker entrypoint only
AUTO_MIGRATE=true
