{
  "name": "@repo/ui",
  "version": "0.1.0",
  "description": "Reusable UI components for Charro Stack (monorepo)",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.ts"
    },
    "./components/*": {
      "types": "./components/*.tsx",
      "default": "./components/*.tsx"
    },
    "./hooks/*": {
      "types": "./hooks/*.ts",
      "default": "./hooks/*.ts"
    },
    "./lib/*": {
      "types": "./lib/*.ts",
      "default": "./lib/*.ts"
    }
  },
  "files": [
    "components",
    "hooks",
    "lib",
    "styles",
    "dist",
    "index.ts",
    "index.d.ts"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=19.3.0",
    "react-dom": ">=19.3.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.574.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3"
  },
  "license": "MIT"
}
