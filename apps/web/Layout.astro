---
import { LanguageSwitcher } from "./components/LanguageSwitcher";
import { getTranslations } from "./i18n";
import { spaUrl } from "./lib/spa-url";
import "./styles/globals.css";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const t = getTranslations(Astro.currentLocale);

const {
  title = t.meta.title,
  description = t.meta.description,
  image = "/og.png",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImageUrl = new URL(image, Astro.site ?? canonicalUrl);
const ogLocale = Astro.currentLocale === "es" ? "es_ES" : "en_US";
---

<!doctype html>
<html lang={Astro.currentLocale ?? "en"} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (() => {
        const cookieName = "saas-lang";

        if (window.location.pathname !== "/") {
          return;
        }

        const cookie = document.cookie
          .split("; ")
          .find((part) => part.startsWith(`${cookieName}=`));
        const storedLocale = cookie?.split("=")[1];
        const browserLocale = String(
          (navigator.languages && navigator.languages[0]) ??
            navigator.language ??
            "en",
        ).toLowerCase();
        const detectedLocale = browserLocale.startsWith("es") ? "es" : "en";
        const locale =
          storedLocale === "es" || storedLocale === "en"
            ? storedLocale
            : detectedLocale;

        if (storedLocale !== locale) {
          document.cookie = `${cookieName}=${locale}; path=/; max-age=31536000; SameSite=Lax`;
        }

        if (locale === "es") {
          window.location.replace(
            `/es/${window.location.search}${window.location.hash}`,
          );
        }
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="64x64" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link
      rel="apple-touch-icon"
      href="/apple-touch-icon.png"
      sizes="180x180"
    />
    <link rel="manifest" href="/site.manifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index,follow" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={t.header.logoAlt} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
  </head>
  <body class="overflow-x-hidden bg-white text-[#0b0b0b] antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:bg-white focus:px-3 focus:py-2 focus:text-sm focus:text-[#0b0b0b] focus:ring-2 focus:ring-[#fd410b]"
    >
      {t.header.skipToContent}
    </a>
    <div class="flex min-h-screen flex-col bg-white">
      <main id="main" class="flex-1">
        <slot />
      </main>

      <footer class="page-footer">
        <div class="page-wrap">
          <div class="page-footer-grid">
            <div>
              <p class="page-footer-title">{t.footer.tagline}</p>
              <p class="page-footer-copy">{t.footer.description}</p>
            </div>
            <nav aria-label={t.footer.navLabel}>
              <p class="page-footer-title">{t.footer.startHeading}</p>
              <a href={spaUrl("/signup")}>{t.footer.links.signup}</a>
              <a href={spaUrl("/login")}>{t.footer.links.login}</a>
            </nav>
          </div>
          <div class="page-footer-meta">
            <div class="flex flex-wrap items-center justify-between gap-4">
              <p>
                &copy; {new Date().getFullYear()}
                {t.header.logoAlt}. {t.footer.copyright}
              </p>
              <LanguageSwitcher
                client:idle
                locale={Astro.currentLocale ?? "en"}
                labels={t.header.langSwitcher}
              />
            </div>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
