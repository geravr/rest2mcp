---
import type { UI } from "../../i18n";
import { Shield } from "lucide-react";

interface Props {
  security: UI["security"];
}

const { security } = Astro.props;
---

<section id="security" class="scroll-mt-20 border-b border-border bg-background py-24">
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-16 max-w-3xl text-center">
      <h2
        class="text-3xl font-semibold tracking-tight text-foreground md:text-4xl"
      >
        {security.title}
      </h2>
      <p class="mt-4 text-base text-muted-foreground sm:text-lg">
        {security.subtitle}
      </p>
    </div>

    <ul class="mx-auto max-w-5xl space-y-6">
      {
        security.bullets.map((bullet) => (
          <li class="flex gap-4 border border-border p-6">
            <Shield className="mt-0.5 h-5 w-5 shrink-0 text-muted-foreground" aria-hidden="true" />
            <div class="min-w-0">
              <h3 class="font-medium text-foreground">{bullet.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                {bullet.desc}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
