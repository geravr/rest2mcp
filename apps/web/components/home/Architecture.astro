---
import type { UI } from "../../i18n";
import { Check } from "lucide-react";

interface Props {
  architecture: UI["architecture"];
}

const { architecture } = Astro.props;

function highlightStructureCode(code: string): string {
  return code
    .split("\n")
    .map((line) => {
      const topLevel = line.match(/^(apps\/|packages\/|db\/)(.*)/);
      if (topLevel) {
        return `<span class="text-foreground font-medium">${topLevel[1]}</span>${topLevel[2]}`;
      }

      const nested = line.match(/^(\s+)(\w+\/)(.*)/);
      if (nested) {
        return `${nested[1]}<span class="text-foreground">${nested[2]}</span>${nested[3]}`;
      }

      return line;
    })
    .join("\n");
}

const highlightedCode = highlightStructureCode(architecture.structureCode);
---

<section id="architecture" class="border-b border-border bg-background py-24">
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid min-w-0 items-center gap-12 lg:grid-cols-2">
      <div class="min-w-0 space-y-6">
        <h2
          class="text-balance text-3xl font-semibold tracking-tight text-foreground md:text-4xl"
        >
          {architecture.title}
        </h2>
        <p class="text-base leading-relaxed text-muted-foreground">
          {architecture.subtitle}
        </p>
        <ul class="space-y-4">
          {
            architecture.bullets.map((bullet) => (
              <li class="flex items-start gap-3">
                <Check className="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" />
                <div class="min-w-0">
                  <strong class="font-medium text-foreground">
                    {bullet.title}
                  </strong>
                  <p class="text-sm text-muted-foreground">{bullet.desc}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="min-w-0 overflow-hidden rounded-md border border-border bg-muted p-4 font-mono text-sm sm:p-6"
      >
        <p class="mb-4 text-xs text-muted-foreground">
          {architecture.structureLabel}
        </p>
        <pre
          class="overflow-x-auto text-xs leading-relaxed text-muted-foreground md:text-sm"
          set:html={highlightedCode}
        />
      </div>
    </div>
  </div>
</section>
