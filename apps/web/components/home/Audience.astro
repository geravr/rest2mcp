---
import type { UI } from "../../i18n";

interface Props {
  audience: UI["audience"];
}

const { audience } = Astro.props;
---

<section class="border-b border-border bg-background py-24">
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-16 max-w-3xl text-center">
      <h2
        class="text-3xl font-semibold tracking-tight text-foreground md:text-4xl"
      >
        {audience.title}
      </h2>
      <p class="mt-4 text-base text-muted-foreground sm:text-lg">
        {audience.subtitle}
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-3">
      {
        audience.personas.map((persona) => (
          <div class="border border-border p-8">
            <h3 class="font-medium text-foreground">{persona.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
              {persona.desc}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
