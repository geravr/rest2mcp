---
import type { UI } from "../../i18n";

interface Props {
  techStack: UI["techStack"];
}

const { techStack } = Astro.props;
---

<section id="tech-stack" class="border-b border-border bg-muted py-24">
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-16 max-w-3xl text-center">
      <h2
        class="text-3xl font-semibold tracking-tight text-foreground md:text-4xl"
      >
        {techStack.title}
      </h2>
      <p class="mt-4 text-base text-muted-foreground sm:text-lg">
        {techStack.subtitle}
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        techStack.items.map((tech) => (
          <div class="border border-border bg-background p-6">
            <h3 class="font-medium text-foreground">
              {tech.name}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
              {tech.desc}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
