---
import type { UI } from "../../i18n";

interface Props {
  ui: UI;
}

const { ui } = Astro.props;
const session = ui.session;
const defaultIndex = session.cast.findIndex(
  (entry) => entry.path === "/v1/invoices/{id}/void",
);
const selected = defaultIndex >= 0 ? defaultIndex : 0;
const blocked = ["POST", "PUT", "PATCH", "DELETE"];
const entry = session.cast[selected] ?? session.cast[0];
const guardHidden = !blocked.includes(entry.method);

const payload = {
  cast: session.cast,
  guardNote: session.guardNote,
  origin: session.origin,
  playgroundLabel: session.playgroundLabel,
  token: ui.howItWorks.token,
};
---

<section
  class="session"
  id="how-it-works"
  aria-label={ui.howItWorks.title}
  data-session
  data-selected={selected}
>
  <header class="session-head">
    <h2 class="session-title">{session.title}</h2>
  </header>

  <div class="session-picker" role="group" aria-label={session.pickerLabel}>
    <span class="session-picker-label">{session.pickerLabel}</span>
    <ul class="session-chips">
      {
        session.cast.map((row, index) => (
          <li>
            <button
              type="button"
              class="session-chip"
              data-chip={index}
              aria-pressed={index === selected ? "true" : "false"}
            >
              <span class="session-chip-method">{row.method}</span>
              <code>{row.path}</code>
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="session-pin" data-session-pin>
    <div class="session-sticky">
      <div class="session-stage">
        <article class="session-window" aria-label={session.buildHeader}>
          <header class="session-window-head">
            <span class="session-window-who">
              <span class="session-avatar" aria-hidden="true">r2</span>
              <span>{session.buildHeader}</span>
            </span>
          </header>
          <div class="session-transcript">
            <p class="session-user" data-anim="b1">
              <span data-cast="buildUser">{entry.buildUser}</span>
            </p>
            <div class="session-think" data-anim="b2">
              <p class="session-think-label">{session.thinkingLabel}</p>
              <p data-cast="buildThink">{entry.buildThink}</p>
            </div>
            <div class="session-tools" data-anim="b3">
              <div class="session-tool">
                <span class="session-tool-k">{session.toolLabel}</span>
                <code data-cast="buildTool">{entry.buildTool}</code>
                <span data-cast="buildToolDetail">{entry.buildToolDetail}</span>
              </div>
              <div class="session-tool" data-cast-guard hidden={guardHidden}>
                <span class="session-tool-k">{session.toolLabel}</span>
                <code>mutation_guard</code>
                <span data-cast="guard">
                  {session.guardNote.replace("{method}", entry.method)}
                </span>
              </div>
              <div class="session-tool">
                <span class="session-tool-k">{session.toolLabel}</span>
                <code>{session.playgroundLabel}</code>
                <span>
                  <span data-cast="buildPlay">{entry.buildPlay}</span>
                </span>
              </div>
            </div>
            <p class="session-assistant" data-anim="b4">
              <span data-cast="buildReply">{entry.buildReply}</span>
            </p>
            <div class="session-card-from" data-card-from>
              <aside
                class="session-card"
                data-anim="card"
                aria-label={session.cardTitle}
              >
                <p class="session-card-title">{session.cardTitle}</p>
                <p class="session-card-url" data-anim="card-url">
                  <code>{session.serverUrl}</code>
                </p>
                <dl class="session-card-meta">
                  <div>
                    <dt>URL</dt>
                    <dd>
                      <code>{session.origin}{session.serverUrl}</code>
                    </dd>
                  </div>
                  <div>
                    <dt>{session.cardAuthLabel}</dt>
                    <dd>
                      <code>{ui.howItWorks.token}</code>
                    </dd>
                  </div>
                  <div>
                    <dt>Transport</dt>
                    <dd>
                      <code>{session.cardTransport}</code>
                    </dd>
                  </div>
                  <div>
                    <dt>Tool</dt>
                    <dd>
                      <code data-cast="cardTool">{entry.tool}</code>
                    </dd>
                  </div>
                </dl>
                <p class="session-card-caption">{session.handshakeCaption}</p>
              </aside>
            </div>
          </div>
          <div class="session-composer" aria-hidden="true">
            <span>{session.composerHint}</span>
          </div>
        </article>

        <article
          class="session-window session-window-work"
          aria-label={session.workLabel}
        >
          <header class="session-window-head">
            <span class="session-window-who">
              <span class="session-avatar session-avatar-work" aria-hidden="true">
                {entry.specialist.slice(0, 1).toUpperCase()}
              </span>
              <span>
                {session.workLabel} ·
                <span data-cast="specialist">{entry.specialist}</span>
              </span>
            </span>
            <span class="session-live" data-anim="live">
              <span class="session-live-dot" aria-hidden="true"></span>
              {session.liveLabel}
            </span>
          </header>
          <div class="session-transcript">
            <div class="session-card-to" data-card-to></div>
            <p class="session-user" data-anim="w1">
              <span data-cast="workUser">{entry.workUser}</span>
            </p>
            <div class="session-think" data-anim="w2">
              <p class="session-think-label">{session.thinkingLabel}</p>
              <p data-cast="workThink">{entry.workThink}</p>
            </div>
            <div class="session-tools" data-anim="w3">
              <div class="session-tool">
                <span class="session-tool-k">{session.toolLabel}</span>
                <code data-cast="tool">{entry.tool}</code>
                <span data-cast="args">{entry.args}</span>
              </div>
              <div class="session-tool session-tool-result">
                <span class="session-tool-k">{session.toolLabel}</span>
                <code>result</code>
                <span data-cast="result">{entry.result}</span>
              </div>
            </div>
            <p class="session-assistant" data-anim="w4">
              <span data-cast="workReply">{entry.workReply}</span>
            </p>
          </div>
          <div class="session-composer" aria-hidden="true">
            <span>{session.composerWorkHint}</span>
          </div>
        </article>
      </div>
    </div>
  </div>

  <script
    type="application/json"
    data-session-payload
    set:html={JSON.stringify(payload)}
  />
</section>

<script>
  const EASE = "cubic-bezier(0.23, 1, 0.32, 1)";
  const DURATION = 1000;

  interface CastEntry {
    method: string;
    path: string;
    tool: string;
    schema: string;
    specialist: string;
    buildUser: string;
    buildThink: string;
    buildTool: string;
    buildToolDetail: string;
    buildPlay: string;
    buildReply: string;
    workUser: string;
    workThink: string;
    args: string;
    result: string;
    workReply: string;
  }

  interface Payload {
    cast: CastEntry[];
    guardNote: string;
    origin: string;
    playgroundLabel: string;
    token: string;
  }

  const IN: Keyframe[] = [
    { opacity: 0, transform: "translateY(8px)" },
    { opacity: 1, transform: "translateY(0)" },
  ];

  function at(from: number, to: number, frames: Keyframe[] = IN): Keyframe[] {
    const first = frames[0] ?? {};
    const last = frames[frames.length - 1] ?? {};
    return [
      { ...first, offset: 0 },
      { ...first, offset: from },
      ...frames.slice(1, -1).map((frame, index) => ({
        ...frame,
        offset:
          from + ((to - from) * (index + 1)) / Math.max(frames.length - 1, 1),
      })),
      { ...last, offset: to },
      { ...last, offset: 1 },
    ];
  }

  function setup(root: HTMLElement) {
    const payloadEl = root.querySelector<HTMLScriptElement>(
      "[data-session-payload]",
    );
    const payload: Payload | null = payloadEl?.textContent
      ? JSON.parse(payloadEl.textContent)
      : null;

    const chips = [...root.querySelectorAll<HTMLButtonElement>("[data-chip]")];
    const castNodes = [...root.querySelectorAll<HTMLElement>("[data-cast]")];
    const guardRow = root.querySelector<HTMLElement>("[data-cast-guard]");
    const workAvatar = root.querySelector<HTMLElement>(
      ".session-avatar-work",
    );

    function render(entry: CastEntry) {
      if (!payload) {
        return;
      }
      const values: Record<string, string> = {
        buildUser: entry.buildUser,
        buildThink: entry.buildThink,
        buildTool: entry.buildTool,
        buildToolDetail: entry.buildToolDetail,
        buildPlay: entry.buildPlay,
        buildReply: entry.buildReply,
        specialist: entry.specialist,
        workUser: entry.workUser,
        workThink: entry.workThink,
        tool: entry.tool,
        cardTool: entry.tool,
        args: entry.args,
        result: entry.result,
        workReply: entry.workReply,
        guard: payload.guardNote.replace("{method}", entry.method),
      };
      for (const node of castNodes) {
        const key = node.dataset.cast;
        if (!key || !(key in values)) {
          continue;
        }
        node.textContent = values[key];
        node.animate([{ opacity: 0.15 }, { opacity: 1 }], {
          duration: 180,
          easing: EASE,
        });
      }
      if (guardRow) {
        guardRow.hidden = !["POST", "PUT", "PATCH", "DELETE"].includes(
          entry.method,
        );
      }
      if (workAvatar) {
        workAvatar.textContent = entry.specialist.slice(0, 1).toUpperCase();
      }
    }

    if (payload) {
      for (const chip of chips) {
        chip.addEventListener("click", () => {
          const entry = payload.cast[Number(chip.dataset.chip)];
          if (!entry) {
            return;
          }
          for (const other of chips) {
            other.setAttribute("aria-pressed", String(other === chip));
          }
          render(entry);
        });
      }
    }

    const reduce = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const wide = window.matchMedia("(min-width: 900px)").matches;
    const pin = root.querySelector<HTMLElement>("[data-session-pin]");
    if (reduce || !wide || !pin) {
      return;
    }

    const stage = root.querySelector<HTMLElement>(".session-stage");
    const card = root.querySelector<HTMLElement>("[data-anim='card']");
    const fromSlot = root.querySelector<HTMLElement>("[data-card-from]");
    const toSlot = root.querySelector<HTMLElement>("[data-card-to]");

    const animations: Animation[] = [];
    const bind = (
      name: string,
      frames: Keyframe[],
      easing: string = "linear",
    ) => {
      const el = root.querySelector<HTMLElement>(`[data-anim='${name}']`);
      if (!el) {
        return;
      }
      const animation = el.animate(frames, {
        duration: DURATION,
        fill: "both",
        easing,
      });
      animation.pause();
      animations.push(animation);
    };

    bind("b1", at(0.02, 0.1));
    bind("b2", at(0.12, 0.22));
    bind("b3", at(0.24, 0.36));
    bind("b4", at(0.38, 0.48));
    bind(
      "card-url",
      at(0.5, 0.62, [
        { opacity: 1, color: "#edeae4" },
        { opacity: 1, color: "#fd410b" },
      ]),
      "linear",
    );
    bind("live", at(0.72, 0.78));
    bind("w1", at(0.76, 0.82));
    bind("w2", at(0.82, 0.87));
    bind("w3", at(0.87, 0.93));
    bind("w4", at(0.93, 0.99));

    let cardAnimation: Animation | null = null;
    let lastProgress = 0;

    const buildCardTravel = () => {
      if (!stage || !card || !fromSlot || !toSlot) {
        return;
      }
      cardAnimation?.cancel();
      toSlot.style.minHeight = `${card.offsetHeight}px`;
      const fromRect = fromSlot.getBoundingClientRect();
      const toRect = toSlot.getBoundingClientRect();
      const dx = toRect.left - fromRect.left;
      const dy = toRect.top - fromRect.top;
      const frames: Keyframe[] = [
        {
          offset: 0,
          opacity: 0,
          transform: "translate(0, 0) scale(0.96)",
        },
        {
          offset: 0.48,
          opacity: 0,
          transform: "translate(0, 0) scale(0.96)",
        },
        {
          offset: 0.54,
          opacity: 1,
          transform: "translate(0, 0) scale(1)",
        },
        {
          offset: 0.74,
          opacity: 1,
          transform: `translate(${dx}px, ${dy}px) scale(1)`,
        },
        {
          offset: 1,
          opacity: 1,
          transform: `translate(${dx}px, ${dy}px) scale(1)`,
        },
      ];
      cardAnimation = card.animate(frames, {
        duration: DURATION,
        fill: "both",
        easing: "linear",
      });
      cardAnimation.pause();
      cardAnimation.currentTime = lastProgress * DURATION;
    };

    let ticking = false;

    const update = () => {
      ticking = false;
      const max = pin.offsetHeight - window.innerHeight;
      const top = pin.getBoundingClientRect().top;
      lastProgress = max <= 0 ? 1 : Math.min(1, Math.max(0, -top / max));
      for (const animation of animations) {
        animation.currentTime = lastProgress * DURATION;
      }
      if (cardAnimation) {
        cardAnimation.currentTime = lastProgress * DURATION;
      }
    };

    const onScroll = () => {
      if (ticking) {
        return;
      }
      ticking = true;
      window.requestAnimationFrame(update);
    };

    buildCardTravel();
    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", () => {
      buildCardTravel();
      onScroll();
    });
  }

  const root = document.querySelector<HTMLElement>("[data-session]");
  if (root) {
    setup(root);
  }
</script>
