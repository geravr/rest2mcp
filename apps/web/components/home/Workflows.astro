---
import type { UI } from "../../i18n";
import { Check } from "lucide-react";

interface Props {
  workflows: UI["workflows"];
}

const { workflows } = Astro.props;
---

<section class="border-b border-border bg-muted py-24">
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-16 max-w-3xl text-center">
      <h2
        class="text-3xl font-semibold tracking-tight text-foreground md:text-4xl"
      >
        {workflows.title}
      </h2>
      <p class="mt-4 text-base text-muted-foreground sm:text-lg">
        {workflows.subtitle}
      </p>
    </div>

    <div class="grid gap-8 lg:grid-cols-2">
      {
        [workflows.gui, workflows.platformMcp].map((column) => (
          <div class="border border-border bg-background p-8">
            <h3 class="text-xl font-medium text-foreground">{column.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
              {column.desc}
            </p>
            <ul class="mt-6 space-y-3">
              {column.bullets.map((bullet) => (
                <li class="flex items-start gap-3">
                  <Check className="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" aria-hidden="true" />
                  <span class="text-sm text-muted-foreground">{bullet}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
