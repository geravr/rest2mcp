---
import type { UI } from "../../i18n";
import { Zap, Shield, Database, Layers } from "lucide-react";

interface Props {
  features: UI["features"];
}

const { features } = Astro.props;

const icons = [Layers, Zap, Database, Shield];
---

<section id="features" class="border-b border-border bg-background py-24">
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-16 max-w-3xl text-center">
      <h2
        class="text-3xl font-semibold tracking-tight text-foreground md:text-4xl"
      >
        {features.title}
      </h2>
      <p class="mt-4 text-base text-muted-foreground sm:text-lg">
        {features.subtitle}
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
      {
        features.items.map((item, index) => {
          const Icon = icons[index] ?? Layers;
          return (
            <div class="border border-border bg-background p-8">
              <Icon className="mb-4 h-5 w-5 text-muted-foreground" />
              <h3 class="font-medium text-foreground">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                {item.desc}
              </p>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
