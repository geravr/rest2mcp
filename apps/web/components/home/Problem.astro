---
import type { UI } from "../../i18n";
import { X } from "lucide-react";

interface Props {
  problem: UI["problem"];
}

const { problem } = Astro.props;
---

<section class="border-b border-border bg-muted py-24">
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <h2
        class="text-3xl font-semibold tracking-tight text-foreground md:text-4xl"
      >
        {problem.title}
      </h2>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground sm:text-lg">
        {problem.body}
      </p>
    </div>

    <ul class="mx-auto mt-12 max-w-5xl space-y-6 sm:columns-2 sm:gap-6">
      {
        problem.bullets.map((bullet) => (
          <li class="break-inside-avoid border border-border bg-background p-6 sm:mb-6">
            <X className="mb-3 h-5 w-5 text-muted-foreground" aria-hidden="true" />
            <h3 class="font-medium text-foreground">{bullet.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
              {bullet.desc}
            </p>
          </li>
        ))
      }
    </ul>

    <p
      class="mx-auto mt-10 max-w-3xl text-center text-base font-medium leading-relaxed text-foreground sm:text-lg"
    >
      {problem.contrast}
    </p>
  </div>
</section>
