---
import type { UI } from "../../i18n";
import { spaUrl } from "../../lib/spa-url";

interface Props {
  hero: UI["hero"];
  logoAlt: string;
  signup: string;
  login: string;
}

const { hero: _hero, logoAlt, signup, login } = Astro.props;

const endpoints = [
  { method: "GET", path: "/v1/users" },
  { method: "POST", path: "/v1/users" },
  { method: "GET", path: "/v1/users/{id}" },
  { method: "PUT", path: "/v1/users/{id}" },
  { method: "DELETE", path: "/v1/users/{id}" },
  { method: "GET", path: "/v1/users/{id}/settings", extra: true },
  { method: "PATCH", path: "/v1/settings" },
  { method: "GET", path: "/v1/invoices" },
  { method: "GET", path: "/v1/invoices/{id}", extra: true },
  { method: "POST", path: "/v1/invoices" },
  { method: "POST", path: "/v1/invoices/{id}/void", extra: true },
  { method: "GET", path: "/v1/invoices/{id}/lines", extra: true },
  { method: "GET", path: "/v1/orders" },
  { method: "GET", path: "/v1/orders/{id}", extra: true },
  { method: "POST", path: "/v1/orders", extra: true },
  { method: "PATCH", path: "/v1/orders/{id}", extra: true },
  { method: "DELETE", path: "/v1/orders/{id}", extra: true },
  { method: "GET", path: "/v1/orders/{id}/items", extra: true },
  { method: "POST", path: "/v1/orders/{id}/cancel", extra: true },
  { method: "GET", path: "/v1/webhooks", extra: true },
  { method: "POST", path: "/v1/webhooks", extra: true },
  { method: "DELETE", path: "/v1/webhooks/{id}", extra: true },
  { method: "GET", path: "/v1/events", extra: true },
  { method: "POST", path: "/v1/events/{id}/replay", extra: true },
  { method: "GET", path: "/v1/keys" },
  { method: "DELETE", path: "/v1/keys/{id}" },
] as const;

const tools = [
  "get_customer",
  "list_invoices",
  "get_invoice",
  "search_orders",
  "get_order",
  "list_payments",
];
---

<div class="gate-pin" data-gate-pin>
  <section class="gate-sticky" aria-label={logoAlt}>
    <p class="sr-only">{logoAlt}</p>

    <div class="gate-start">
      <ul class="gate-endpoints" data-gate-list data-gate-anim="list-left">
        {endpoints.map((row) => (
          <li class:list={[{ "gate-row-extra": "extra" in row && row.extra }]}>
            <span class="gate-method" data-method={row.method}>
              {row.method}
            </span>
            <code class="gate-path">{row.path}</code>
          </li>
        ))}
      </ul>

      <img
        class="gate-symbol"
        data-gate-anim="symbol"
        src="/icon-dark.png"
        alt=""
        width="256"
        height="256"
      />

      <ul class="gate-tools" data-gate-list data-gate-anim="list-right">
        {tools.map((name, index) => (
          <li class:list={[{ "gate-row-extra": index >= 4 }]}>{name}</li>
        ))}
      </ul>
    </div>

    <div class="gate-end">
      <div class="gate-lockup" aria-hidden="true">
        <div class="gate-crop gate-crop-rest" data-gate-anim="rest">
          <img
            src="/logo-dark.png"
            alt=""
            width="480"
            height="127"
          />
        </div>
        <div class="gate-crop gate-crop-two" data-gate-anim="two">
          <img
            src="/logo-dark.png"
            alt=""
            width="480"
            height="127"
          />
        </div>
        <div class="gate-crop gate-crop-mcp" data-gate-anim="mcp">
          <img
            src="/logo-dark.png"
            alt=""
            width="480"
            height="127"
          />
        </div>
      </div>

      <nav class="gate-cta" data-gate-anim="cta" data-gate-cta>
        <a class="gate-cta-signup" href={spaUrl("/signup")}>{signup}</a>
        <a class="gate-cta-login" href={spaUrl("/login")}>{login}</a>
      </nav>
    </div>
  </section>
</div>

<script>
  const EASE = "cubic-bezier(0.77, 0, 0.175, 1)";

  // Orange "2" width within the 256px transparent symbol canvas.
  const SYMBOL_GLYPH_RATIO = 239 / 256;

  interface GateHandoff {
    dx: number;
    scale: number;
  }

  function buildKeyframes(handoff: GateHandoff): Record<string, Keyframe[]> {
    const { dx, scale } = handoff;
    const px = (value: number) => `${value.toFixed(2)}px`;
    const sc = (value: number) => value.toFixed(4);
    const handoffScale = Math.min(Math.max(scale, 0.2), 1);

    return {
      "list-left": [
        { offset: 0, opacity: 1, transform: "translateX(0) scale(1)" },
        { offset: 0.4, opacity: 0.35, transform: "translateX(12%) scale(0.97)" },
        { offset: 0.55, opacity: 0, transform: "translateX(20%) scale(0.95)" },
        { offset: 1, opacity: 0, transform: "translateX(20%) scale(0.95)" },
      ],
      "list-right": [
        { offset: 0, opacity: 1, transform: "translateX(0) scale(1)" },
        { offset: 0.4, opacity: 0.35, transform: "translateX(-12%) scale(0.97)" },
        { offset: 0.55, opacity: 0, transform: "translateX(-20%) scale(0.95)" },
        { offset: 1, opacity: 0, transform: "translateX(-20%) scale(0.95)" },
      ],
      symbol: [
        { offset: 0, opacity: 1, transform: "translateX(0px) scale(1)" },
        {
          offset: 0.42,
          opacity: 1,
          transform: `translateX(${px(dx * 0.94)}) scale(${sc(handoffScale)})`,
        },
        {
          offset: 0.5,
          opacity: 0,
          transform: `translateX(${px(dx)}) scale(${sc(handoffScale)})`,
        },
        {
          offset: 1,
          opacity: 0,
          transform: `translateX(${px(dx)}) scale(${sc(handoffScale)})`,
        },
      ],
      rest: [
        { offset: 0, opacity: 0, transform: "translateX(-18%) scale(0.96)" },
        { offset: 0.3, opacity: 0, transform: "translateX(-14%) scale(0.96)" },
        { offset: 0.58, opacity: 1, transform: "translateX(-4%) scale(1)" },
        { offset: 1, opacity: 1, transform: "translateX(0) scale(1)" },
      ],
      two: [
        {
          offset: 0,
          opacity: 0,
          transform: `scale(${sc(handoffScale)})`,
        },
        {
          offset: 0.48,
          opacity: 0,
          transform: `scale(${sc(handoffScale)})`,
        },
        { offset: 0.52, opacity: 1, transform: `scale(${sc(handoffScale)})` },
        { offset: 0.64, opacity: 1, transform: "scale(1)" },
        { offset: 1, opacity: 1, transform: "scale(1)" },
      ],
      mcp: [
        { offset: 0, opacity: 0, transform: "translateX(18%) scale(0.96)" },
        { offset: 0.3, opacity: 0, transform: "translateX(14%) scale(0.96)" },
        { offset: 0.58, opacity: 1, transform: "translateX(4%) scale(1)" },
        { offset: 1, opacity: 1, transform: "translateX(0) scale(1)" },
      ],
      cta: [
        { offset: 0, opacity: 0, transform: "translateY(0.75rem)" },
        { offset: 0.72, opacity: 0, transform: "translateY(0.75rem)" },
        { offset: 0.88, opacity: 1, transform: "translateY(0)" },
        { offset: 1, opacity: 1, transform: "translateY(0)" },
      ],
    };
  }

  function measureHandoff(pin: HTMLElement): GateHandoff {
    const symbol = pin.querySelector<HTMLElement>(".gate-symbol");
    const two = pin.querySelector<HTMLElement>(".gate-crop-two");
    if (!symbol || !two) {
      return { dx: 0, scale: 0.62 };
    }

    const symBox = symbol.getBoundingClientRect();
    const twoBox = two.getBoundingClientRect();

    const symbolGlyphWidth = symBox.width * SYMBOL_GLYPH_RATIO;
    const scale =
      symbolGlyphWidth > 0 ? twoBox.width / symbolGlyphWidth : 0.62;

    const dx =
      twoBox.left +
      twoBox.width / 2 -
      (symBox.left + symBox.width / 2);

    return { dx, scale };
  }

  function setup(pin: HTMLElement) {
    const reduce = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    if (reduce) {
      return;
    }

    const pieces = [
      ...pin.querySelectorAll<HTMLElement>("[data-gate-anim]"),
    ];
    const lists = pin.querySelectorAll<HTMLElement>("[data-gate-list]");
    const cta = pin.querySelector<HTMLElement>("[data-gate-cta]");

    let animations: Animation[] = [];
    let ticking = false;
    let resizeFrame = 0;

    const createAnimations = () => {
      for (const animation of animations) {
        animation.cancel();
      }

      const handoff = measureHandoff(pin);
      const keyframes = buildKeyframes(handoff);

      animations = pieces.flatMap((el) => {
        const name = el.dataset.gateAnim;
        const frames = name ? keyframes[name] : undefined;
        if (!frames) {
          return [];
        }
        const animation = el.animate(frames, {
          duration: 1000,
          fill: "both",
          easing: EASE,
        });
        animation.pause();
        return [animation];
      });
    };

    const update = () => {
      ticking = false;
      const max = pin.offsetHeight - window.innerHeight;
      const top = pin.getBoundingClientRect().top;
      const progress =
        max <= 0 ? 0 : Math.min(1, Math.max(0, -top / max));

      for (const animation of animations) {
        animation.currentTime = progress * 1000;
      }

      const hidden = progress > 0.5;
      for (const list of lists) {
        list.setAttribute("aria-hidden", hidden ? "true" : "false");
      }
      cta?.toggleAttribute("inert", progress < 0.78);
    };

    const onScroll = () => {
      if (ticking) {
        return;
      }
      ticking = true;
      window.requestAnimationFrame(update);
    };

    const onResize = () => {
      cancelAnimationFrame(resizeFrame);
      resizeFrame = window.requestAnimationFrame(() => {
        const progress =
          pin.offsetHeight <= window.innerHeight
            ? 0
            : Math.min(
                1,
                Math.max(
                  0,
                  -pin.getBoundingClientRect().top /
                    (pin.offsetHeight - window.innerHeight),
                ),
              );
        createAnimations();
        for (const animation of animations) {
          animation.currentTime = progress * 1000;
        }
      });
    };

    createAnimations();
    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onResize);
  }

  const pin = document.querySelector<HTMLElement>("[data-gate-pin]");
  if (pin) {
    setup(pin);
  }
</script>
