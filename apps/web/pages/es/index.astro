---
import { getTranslations } from "../../i18n";
import Layout from "../../Layout.astro";
import Hero from "../../components/home/Hero.astro";
import Features from "../../components/home/Features.astro";
import TechStack from "../../components/home/TechStack.astro";
import Architecture from "../../components/home/Architecture.astro";
import FAQ from "../../components/home/FAQ.astro";
import FinalCta from "../../components/home/FinalCta.astro";

const t = getTranslations("es");
---

<Layout>
  <Hero hero={t.hero} />
  <Features features={t.features} />
  <TechStack techStack={t.techStack} />
  <Architecture architecture={t.architecture} />
  <FAQ faq={t.faq} />
  <FinalCta finalCta={t.finalCta} />
</Layout>
