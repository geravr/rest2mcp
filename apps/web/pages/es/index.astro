---
import { getTranslations } from "../../i18n";
import Layout from "../../Layout.astro";
import Hero from "../../components/home/Hero.astro";
import Define from "../../components/home/Define.astro";
import Session from "../../components/home/Session.astro";
import Ledger from "../../components/home/Ledger.astro";

const t = getTranslations("es");
---

<Layout>
  <Hero
    hero={t.hero}
    logoAlt={t.header.logoAlt}
    signup={t.header.signup}
    login={t.header.login}
  />
  <Define ui={t} />
  <Session ui={t} />
  <Ledger ui={t} signup={t.header.signup} login={t.header.login} />
</Layout>
