---
import { getTranslations } from "../../i18n";
import Layout from "../../Layout.astro";
import Hero from "../../components/home/Hero.astro";
import Problem from "../../components/home/Problem.astro";
import HowItWorks from "../../components/home/HowItWorks.astro";
import Features from "../../components/home/Features.astro";
import Workflows from "../../components/home/Workflows.astro";
import Security from "../../components/home/Security.astro";
import Roadmap from "../../components/home/Roadmap.astro";
import Audience from "../../components/home/Audience.astro";
import FAQ from "../../components/home/FAQ.astro";
import FinalCta from "../../components/home/FinalCta.astro";

const t = getTranslations("es");
---

<Layout>
  <Hero hero={t.hero} />
  <Problem problem={t.problem} />
  <HowItWorks howItWorks={t.howItWorks} />
  <Features features={t.features} />
  <Workflows workflows={t.workflows} />
  <Security security={t.security} />
  <Roadmap roadmap={t.roadmap} />
  <Audience audience={t.audience} />
  <FAQ faq={t.faq} />
  <FinalCta finalCta={t.finalCta} />
</Layout>
